{
  "@context": {
    "@version": 1.1,
    "kb": "https://schnaitter.github.io/Kompetenzbrille/vocab/#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "CompetencyFramework": "kb:CompetencyFramework",
    "Phase": "kb:Phase",
    "Dimension": "kb:Dimension",
    "Competency": "kb:Competency",

    "id": { "@id": "kb:id", "@type": "xsd:string" },
    "type": "@type",

    "version": { "@id": "schema:version", "@type": "xsd:string" },
    "language": { "@id": "dcterms:language" },
    "title": "dcterms:title",
    "shortTitle": "schema:alternateName",
    "description": "dcterms:description",
    "source": { "@id": "dcterms:source", "@type": "@id" },
    "doi": "schema:identifier",

    "text": "dcterms:description",
    "note": "skos:scopeNote",

    "phases": { "@id": "kb:hasPhase", "@container": "@set" },
    "dimensions": { "@id": "kb:hasDimension", "@container": "@set" },
    "competencies": { "@id": "kb:hasCompetency", "@container": "@set" },

    "knowledge": { "@id": "kb:requiresKnowledge" },
    "skills": { "@id": "kb:requiresSkill" },
    "examples": { "@id": "kb:hasExample" },

    "phase": { "@id": "kb:inPhase", "@type": "@vocab" },
    "dimension": { "@id": "kb:inDimension", "@type": "@vocab" },

    "code": { "@id": "kb:code", "@type": "xsd:string" },
    "label": "skos:prefLabel"
  },
  "@graph": []
}
