{
  "@context": "https://schnaitter.github.io/Kompetenzbrille/data/schemas/framework-context.jsonld",
  "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4",
  "@type": "CompetencyFramework",
  "id": "quadriga-dlf",
  "version": "4",
  "language": "de",
  "title": "QUADRIGA Datenkompetenzframework",
  "shortTitle": "QUADRIGA v4",
  "description": "Das QUADRIGA Datenkompetenzframework verfolgt ebenfalls das Ziel, die wissenschaftliche Integrität und das Reflexionsvermögen zu fördern und eine grundlegend offene Haltung (gemäß dem Leitprinzip so offen wie möglich und so geschlossen wie nötig) für das Teilen und die Nachnutzung von Forschungsdaten zu unterstützen. Dafür werden in jedem Schritt des datenbasierten Forschungsprozesses (vgl. Datenfluss) notwendige Kompetenzen vermittelt.",
  "doi": "https://doi.org/10.5281/zenodo.19470557",
  "source": "https://schnaitter.github.io/Kompetenzbrille/assets/QUADRIGA-Datenkompetenzframework_v4.pdf",
  "phases": [
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/0",
      "@type": "Phase",
      "id": "0",
      "title": "Orientierungswissen",
      "text": "Hilfreich sind (Vor-)Kenntnisse in grundlegenden Konzepten von Forschungsdatenmanagement und Open X sowie Wissen um Anwendungsgebiete von Daten.",
      "note": "Das Orientierungswissen liegt außerhalb des Datenflusses und der einzelnen Kompetenzen; es bildet die Grundlage für alle Phasen."
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/1",
      "@type": "Phase",
      "id": "1",
      "title": "Planung"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/2",
      "@type": "Phase",
      "id": "2",
      "title": "Erhebung und Aufbereitung"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/3",
      "@type": "Phase",
      "id": "3",
      "title": "Management"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/4",
      "@type": "Phase",
      "id": "4",
      "title": "Analyse"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/5",
      "@type": "Phase",
      "id": "5",
      "title": "Publikation und Nachnutzung"
    }
  ],
  "dimensions": [
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/dimension/knowledge",
      "@type": "Dimension",
      "id": "knowledge",
      "label": "Wissen"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/dimension/skills",
      "@type": "Dimension",
      "id": "skills",
      "label": "Fähigkeit"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/dimension/examples",
      "@type": "Dimension",
      "id": "examples",
      "label": "Beispiele"
    }
  ],
  "competencies": [
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/1.1",
      "@type": "Competency",
      "code": "1.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/1",
      "title": "Identifikation",
      "knowledge": "Arten von Datenquellen; Recherchetechniken",
      "skills": "Identifikation geeigneter Daten",
      "examples": "Abfragesprachen, Datenportale, Forschungsdatenzentren, Repositorien"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/1.2",
      "@type": "Competency",
      "code": "1.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/1",
      "title": "Qualitätssicherung",
      "knowledge": "Qualitätskriterien für Daten; Bewertungsframeworks",
      "skills": "Selbständige Bewertung der Datenqualität nach definierten Kriterien",
      "examples": "Datenkritik, Qualitätskriterien"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/1.3",
      "@type": "Competency",
      "code": "1.3",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/1",
      "title": "Ethik und Recht",
      "knowledge": "Ethische und rechtliche Anforderungen",
      "skills": "Ethische und rechtskonforme (Nach-)Nutzung von Daten",
      "examples": "Datenschutz-Grundverordnung (DSGVO), Gute wissenschaftliche Praxis"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/2.1",
      "@type": "Competency",
      "code": "2.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/2",
      "title": "Erhebung",
      "knowledge": "Methoden und Werkzeuge der Datensammlung und -akquise",
      "skills": "Datenakquise; Datenaggregation",
      "examples": "Erhebungswerkzeuge, (Import-)Schnittstellen"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/2.2",
      "@type": "Competency",
      "code": "2.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/2",
      "title": "Validierung",
      "knowledge": "Qualitätsmanagement; Datenvalidität",
      "skills": "Identifikation von und Umgang mit Fehlern und Lücken in den Daten",
      "examples": "Plausibilität, Repräsentativität"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/2.3",
      "@type": "Competency",
      "code": "2.3",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/2",
      "title": "Aufbereitung",
      "knowledge": "Datenformate; Konvertierungsmethoden; Datenbereinigung",
      "skills": "Datentransformation bzw. -harmonisierung",
      "examples": "Datenbereinigungswerkzeuge, Mappingverfahren"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/3.1",
      "@type": "Competency",
      "code": "3.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/3",
      "title": "Organisation",
      "knowledge": "Methoden, Standards und Werkzeuge der Daten- und Projektorganisation",
      "skills": "Entwicklung von Organisationsprozessen, -strukturen und -zuständigkeiten",
      "examples": "Rollenverteilungen, Versionierung, Verwaltungssysteme, Datenmanagementplan"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/3.2",
      "@type": "Competency",
      "code": "3.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/3",
      "title": "Erschließung",
      "knowledge": "Erschließungsmethoden und -werkzeuge; Metadatenstandards",
      "skills": "Auswahl und Anwendung geeigneter Standards, Beschreibungssprachen und Vokabulare",
      "examples": "Annotation, Anreicherung, (fachspezifische) Standards, Fachsystematiken, Metadatenschemata"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/4.1",
      "@type": "Competency",
      "code": "4.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/4",
      "title": "Datenanalyse",
      "knowledge": "Verfahren und Werkzeuge der Datenanalyse",
      "skills": "Auswahl und Anwendung geeigneter Analysemethoden, -verfahren und -werkzeuge",
      "examples": "Analysewerkzeuge, Reproduzierbarkeit"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/4.2",
      "@type": "Competency",
      "code": "4.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/4",
      "title": "Visualisierung",
      "knowledge": "Methoden und Werkzeuge der Datenvisualisierung",
      "skills": "Auswahl und Anwendung adäquater Visualisierungen",
      "examples": "Gestaltungsprinzipien, Visualisierungswerkzeuge"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/4.3",
      "@type": "Competency",
      "code": "4.3",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/4",
      "title": "Interpretation",
      "knowledge": "Aussagekraft und Einschränkungen von Analyseergebnissen und deren Zusammenhänge",
      "skills": "Systematische Ableitung von evidenzbasierten Schlussfolgerungen und Prognosen",
      "examples": "Objektivität, Transparenz"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/5.1",
      "@type": "Competency",
      "code": "5.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/5",
      "title": "Aufbewahrung",
      "knowledge": "Anforderungen und Methoden für die Erhaltung und Speicherung von Daten",
      "skills": "Bewertung der Speicherwürdigkeit der Daten; Auswahl geeigneter Standards und vertrauenswürdiger Repositorien",
      "examples": "Daten- und Formatmigration, digitale Langzeitarchivierung, Zugangskontrolle"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/5.2",
      "@type": "Competency",
      "code": "5.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/5",
      "title": "Datenpublikation",
      "knowledge": "Methoden und Plattformen für das Publizieren und Teilen von Daten für die Nachnutzung",
      "skills": "Ethische, rechts- und standardkonforme Publikation und Teilung von Daten",
      "examples": "FAIR-Prinzipien, persistente Identifikationssysteme"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/5.3",
      "@type": "Competency",
      "code": "5.3",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/5",
      "title": "Kommunikation",
      "knowledge": "Methoden und Strategien wissenschaftlicher Publikationen und der Wissenschaftskommunikation",
      "skills": "Zielgruppenspezifische Synthese und Kommunikation von Forschungsergebnissen",
      "examples": "Data Storytelling, Outreachformen, Publikationsformen"
    }
  ]
}
