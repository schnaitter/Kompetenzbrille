{
  "@context": "https://schnaitter.github.io/Kompetenzbrille/data/schemas/framework-context.jsonld",
  "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4",
  "@type": "CompetencyFramework",
  "id": "quadriga-dlf",
  "version": "4",
  "language": "en",
  "title": "QUADRIGA Data Literacy Framework",
  "shortTitle": "QUADRIGA v4",
  "description": "The QUADRIGA data literacy framework additionally aims to promote scientific integrity and reflective thinking. It seeks to support an inherently open attitude (in line with the guiding principle of being as open as possible and as closed as necessary) towards the sharing and reuse of research data. To achieve this, the necessary skills are taught at every step of the data-based research process (see data flow).",
  "doi": "https://doi.org/10.5281/zenodo.19470557",
  "source": "https://schnaitter.github.io/Kompetenzbrille/assets/QUADRIGA-DataLiteracyFramework_v4.pdf",
  "phases": [
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/0",
      "@type": "Phase",
      "id": "0",
      "title": "Conceptual knowledge",
      "text": "Prior knowledge of basic concepts of research data management and Open X, as well as knowledge of areas of application for data, are helpful.",
      "note": "The conceptual knowledge (Orientierungswissen) lies outside the data flow and the individual competencies; it forms the foundation of all phases."
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/1",
      "@type": "Phase",
      "id": "1",
      "title": "Planning"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/2",
      "@type": "Phase",
      "id": "2",
      "title": "Collection and preparation"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/3",
      "@type": "Phase",
      "id": "3",
      "title": "Management"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/4",
      "@type": "Phase",
      "id": "4",
      "title": "Analysis"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/5",
      "@type": "Phase",
      "id": "5",
      "title": "Publication and reuse"
    }
  ],
  "dimensions": [
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/dimension/knowledge",
      "@type": "Dimension",
      "id": "knowledge",
      "label": "Knowledge"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/dimension/skills",
      "@type": "Dimension",
      "id": "skills",
      "label": "Skills"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/dimension/examples",
      "@type": "Dimension",
      "id": "examples",
      "label": "Examples"
    }
  ],
  "competencies": [
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/1.1",
      "@type": "Competency",
      "code": "1.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/1",
      "title": "Identification",
      "knowledge": "Types of data sources; search and retrieval techniques",
      "skills": "Identification of adequate data",
      "examples": "Query languages, data portals, research data centers, repositories"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/1.2",
      "@type": "Competency",
      "code": "1.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/1",
      "title": "Quality assurance",
      "knowledge": "Data quality criteria; assessment frameworks",
      "skills": "Independent evaluation of data quality following defined criteria",
      "examples": "Data criticism, quality criteria"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/1.3",
      "@type": "Competency",
      "code": "1.3",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/1",
      "title": "Ethics and legal aspects",
      "knowledge": "Ethical and legal requirements",
      "skills": "Ethical and legally compliant (re-)use of data",
      "examples": "General Data Protection Regulation (GDPR), good research practice"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/2.1",
      "@type": "Competency",
      "code": "2.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/2",
      "title": "Acquisition",
      "knowledge": "Methods and tools for data collection and acquisition",
      "skills": "Data acquisition; data aggregation",
      "examples": "Collection tools, (import) interfaces"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/2.2",
      "@type": "Competency",
      "code": "2.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/2",
      "title": "Validation",
      "knowledge": "Quality management; data validity",
      "skills": "Identification and remediation of data errors and gaps",
      "examples": "Plausibility, representativeness"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/2.3",
      "@type": "Competency",
      "code": "2.3",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/2",
      "title": "(Pre-)processing",
      "knowledge": "Data formats; conversion methods; data cleaning",
      "skills": "Data transformation and harmonisation",
      "examples": "Data cleaning tools, mapping procedures"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/3.1",
      "@type": "Competency",
      "code": "3.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/3",
      "title": "Organisation",
      "knowledge": "Methods, standards, and tools for data and project management",
      "skills": "Development of organisational processes, structures, and governance",
      "examples": "Role allocation, versioning, management systems, data management plan"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/3.2",
      "@type": "Competency",
      "code": "3.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/3",
      "title": "Metadata",
      "knowledge": "Methods and tools for data description; metadata standards",
      "skills": "Selection and application of appropriate standards, description languages, and vocabularies",
      "examples": "Annotation, enrichment, (domain-specific) standards, subject classifications, metadata schemas"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/4.1",
      "@type": "Competency",
      "code": "4.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/4",
      "title": "Data analysis",
      "knowledge": "Methods and tools for data analysis",
      "skills": "Selection and application of appropriate analytical methods, processes, and tools",
      "examples": "Analysis tools, reproducibility"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/4.2",
      "@type": "Competency",
      "code": "4.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/4",
      "title": "Visualisation",
      "knowledge": "Methods and tools for data visualisation",
      "skills": "Selection and application of adequate visualisations",
      "examples": "Design principles, visualisation tools"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/4.3",
      "@type": "Competency",
      "code": "4.3",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/4",
      "title": "Interpretation",
      "knowledge": "Significance and limitations of data analyses and their interdependencies",
      "skills": "Systematic inference of evidence-based conclusions and forecasts",
      "examples": "Objectivity, transparency"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/5.1",
      "@type": "Competency",
      "code": "5.1",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/5",
      "title": "Preservation",
      "knowledge": "Requirements and methods for data preservation",
      "skills": "Appraisal of retention value of data; selection of appropriate standards and trustworthy repositories",
      "examples": "Data and format migration, digital long-term preservation, access control"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/5.2",
      "@type": "Competency",
      "code": "5.2",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/5",
      "title": "Data publication",
      "knowledge": "Methods and platforms for data publication and sharing for reuse",
      "skills": "Ethical, legal, and standard-compliant data publication and sharing",
      "examples": "FAIR principles, persistent identifier systems"
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/5.3",
      "@type": "Competency",
      "code": "5.3",
      "phase": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/phase/5",
      "title": "Communication",
      "knowledge": "Methods and strategies of other scholarly publication formats as well as scholarly and science communication",
      "skills": "Audience-specific synthesis and communication of research findings",
      "examples": "Data storytelling, forms of outreach, forms of publication"
    }
  ]
}
