          "framework": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4",
          "competency": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/2.1",
          "level": 2,
          "note": {
            "de": "Ethnographische Erhebungsmethoden (Feldforschung, Beobachtung) als Datenerhebung.",
            "en": "Ethnographic methods (field research, observation) as data collection."
          }
        },
        {
          "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/module/MWP1/mapping/quadriga-dlf-4_1",
