  "modules": [
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/module/MP1",
      "@type": "Module",
      "code": "MP1",
      "title": "Einführung in die Wissenschaftsforschung",
      "credits": 10,
      "category": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/category/pflicht",
      "goals": "Die Student*innen kennen verschiedene Ansätze der Wissenschaftsforschung aus Soziologie, Ethnologie, Philosophie und Geschichte sowie dem interdisziplinären Feld der Science and Technology Studies. Die Student*innen können unterschiedliche Forschungsfragen der Wissenschaftsforschung einordnen und bewerten. Sie können zentrale methodische Probleme der Wissenschaftsforschung benennen und kennen unterschiedliche Zugänge zur Bearbeitung von Forschungsfragen der Wissenschaftsforschung.",
      "topics": [
        "Zentrale Fragestellungen, Konzepte und Paradigmen der Wissenschaftsforschung",
        "Wissenschaftstheoretische und epistemologische Perspektiven auf die Entstehung, Organisation und Bewertung von Wissen",
        "Ansätze und Theorien zur gesellschaftlichen Einbettung des Wissenschaftssystems",
        "Wissen zu zentralen Akteuren, Institutionen und Funktionslogiken des Wissenschaftssystems",
        "Entwicklungen im Verhältnis von Wissenschaft und Gesellschaft",
        "Empirische Beobachtung, Analyse und Reflexion wissenschaftlicher Praktiken und Institutionen",
        "Grundkonzepte und Strukturen der Wissenschaft wie Publikationskulturen, Bewertungsmechanismen und Förderlogiken",
        "Reflexion zu aktuellen Debatten (z. B. Open Science, Exzellenzinitiativen, Drittmittelabhängigkeit)"
      ],
      "mappings": []
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/module/MP2",
      "@type": "Module",
      "code": "MP2",
      "title": "Methoden der Wissenschaftsforschung",
      "credits": 10,
      "category": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/category/pflicht",
      "goals": "Die Student*innen erwerben ein grundlegendes Verständnis für zentrale Fragestellungen und die damit verbundenen methodischen Konzepte der Wissenschaftsforschung. Sie erhalten einen systematischen Überblick über die wichtigsten methodischen Zugänge (quantitative, qualitative, bibliometrische und netzwerkanalytische Verfahren) und können diese wissenschaftstheoretisch einordnen und bewerten. Auf Basis konkreter Forschungsfragen aus dem Bereich der Wissenschaftsforschung entwickeln die Student*innen eigenständig angemessene methodische Designs. Dabei lernen sie erkenntnistheoretische Grundpositionen kennen und können Forschungsmethoden hinsichtlich ihrer jeweiligen Möglichkeiten und Grenzen kritisch einschätzen.",
      "topics": [
        "Einblick in den Methodenkanon der Wissenschaftsforschung",
        "Überblick über typische Methodenkombinationen in der Wissenschaftsforschung",
        "Anwendungsbeispiele",
        "Fokussierung von Fragestellungen",
        "Überblick über typische Forschungsdesigns",
        "Einüben von Methoden anhand von Beispielen"
      ],
      "mappings": [
