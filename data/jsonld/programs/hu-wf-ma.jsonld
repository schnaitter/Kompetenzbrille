    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/module/MP4",
      "@type": "Module",
      "code": "MP4",
      "title": "Wissenschaft organisieren und gestalten",
      "credits": 10,
      "category": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/category/pflicht",
      "goals": "Die Student*innen erwerben fundierte Kenntnisse über die gesellschaftliche Einbettung des Wissenschaftssystems und verstehen die komplexen Wechselwirkungen und Interaktionsformen der Wissenschaft mit anderen gesellschaftlichen Teilbereichen wie Medien, Politik und Wirtschaft. Sie setzen sich intensiv mit den Institutionen und Verfahren des Wissenstransfers auseinander. Darauf aufbauend entwickeln die Student*innen ein differenziertes Verständnis für die vielschichtigen Legitimations-, Gestaltungs- und Steuerungsmuster der Wissenschaft und werden befähigt, eigenständig Forschungsfragen in diesem Themenbereich zu entwickeln.",
      "topics": [
        "Grundlegende Steuerungs- und Legitimationsmuster der Wissenschaft",
        "Historische und aktuelle Formen der Wechselwirkung zwischen Wissenschaft und Gesellschaft",
        "Kritische Analyse institutioneller Arrangements und Steuerungsinstrumente",
        "Institutionen und Verfahren des Wissenstransfers"
      ],
      "mappings": [
        {
          "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/module/MP4/mapping/quadriga-dlf-5_3",
          "@type": "CompetencyMapping",
          "framework": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4",
          "competency": "https://schnaitter.github.io/Kompetenzbrille/frameworks/quadriga-dlf/4/competency/5.3",
          "level": 1,
          "note": {
            "de": "Institutionen und Verfahren des Wissenstransfers (Wissenschaftskommunikation in die Gesellschaft).",
            "en": "Institutions and procedures of knowledge transfer (science communication to society)."
          }
        }
      ]
    },
    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/module/MP5",
      "@type": "Module",
      "code": "MP5",
      "title": "Projektmodul",
      "credits": 10,
      "category": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/category/pflicht",
      "goals": "Projektmodule dienen der problembezogenen Vertiefung fachwissenschaftlicher Kenntnisse und Methoden. Die Student*innen sind in der Lage, eine größere Aufgabenstellung in Abstimmung mit den beteiligten Mitstudent*innen und unter Anleitung der Lehrer*innen zu bearbeiten. Neben den jeweils fachlichen haben sie sich während der Projektarbeit auch überfachliche Qualifikationen (z. B. Entwicklung von Teamfähigkeit, Kommunikationsfähigkeit, Zeitmanagement) angeeignet.",
      "topics": [
        "Fokussierung auf eine Fragestellung aus der Forschung und Praxis",
        "Planung von Forschungsdesigns",
        "Erstellen eines geeigneten Arbeits- und Zeitplans",
        "Techniken zur Dokumentation von Verfahren und Ergebnissen"
      ],
      "mappings": [
        {
          "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-wf-ma/module/MP5/mapping/quadriga-dlf-3_1",
