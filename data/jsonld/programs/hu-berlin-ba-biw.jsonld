    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-ba-biw/module/BP2",
      "@type": "Module",
      "code": "BP2",
      "title": "Informations- und Kommunikationstechnologie",
      "credits": 10,
      "category": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-ba-biw/category/pflicht",
      "goals": "Die Studierenden verstehen grundlegende Prinzipien und Verfahren der Informations- und Kommunikationstechnologie und deren Begriffswelt. Sie haben ein Verständnis für Computing sowie den Aufbau und die Funktionsweise von Computern entwickelt. Die Studierenden kennen die Grundlagen einer modernen Programmiersprache und sind in der Lage, kleine Programme selbstständig zu schreiben. Im Modul werden Fähigkeiten wie Modellierung, Abstraktion sowie formales bzw. algorithmisches Denken entwickelt.",
      "topics": [
        "Aufbau und Arbeitsweise von Computern",
        "Computing",
        "Mathematische und logische Grundlagen",
        "Algorithmen und Datenstrukturen",
        "Programmierparadigmen",
        "Informationstheorie und -repräsentation",
        "Dateisysteme und -formate",
        "Kommunikation und Datenübertragung",
        "Netzwerke",
        "Internet-Protokolle und -Dienste"
      ],
      "mappings": [
        {
          "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-ba-biw/module/BP2/mapping/quadriga-dlf-2_3",
