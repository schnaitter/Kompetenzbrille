    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-ba-biw/module/BP6",
      "@type": "Module",
      "code": "BP6",
      "title": "Projektmodul",
      "credits": 10,
      "category": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-ba-biw/category/pflicht",
      "goals": "Die Studierenden sind in der Lage, eine größere Aufgabenstellung der realen Berufspraxis in Abstimmung mit den beteiligten Mitstudierenden und unter Anleitung der Lehrenden zu bearbeiten. Neben fachlichen haben sie sich während der Projektarbeit auch überfachliche Qualifikationen (z.B. Entwicklung von Teamfähigkeit, Kommunikationsfähigkeit, Zeitmanagement) angeeignet.",
      "topics": [
        "Projektthemen aus aktuellen Forschungsschwerpunkten bzw. Problemkontexten der Informationswissenschaft",
        "Projektorganisation im Team",
        "Projektdokumentation"
      ],
      "mappings": [
        {
          "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-ba-biw/module/BP6/mapping/quadriga-dlf-3_1",
