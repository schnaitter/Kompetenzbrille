    {
      "@id": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-ba-biw/module/BP5",
      "@type": "Module",
      "code": "BP5",
      "title": "Human Information Behavior",
      "credits": 10,
      "category": "https://schnaitter.github.io/Kompetenzbrille/programs/hu-berlin-ba-biw/category/pflicht",
      "goals": "Die Studierenden können menschliche Verhaltensweisen des Information Seeking und Non-Seeking erklären, beschreiben und in Daten sichtbar machen. Sie sind in der Lage, eigene empirische Nutzerstudien durchzuführen und können Verfahren der Datenbeschreibung und -auswertung anwenden.",
      "topics": [
        "Information Need",
        "Information Seeking",
        "Verhaltensweisen wie Browsing, Encountering, Serendipity",
        "Everyday-life-information behavior",
        "Modelle der Informationsverhaltensforschung",
        "Planung und Durchführung einer empirischen Nutzerstudie",
        "Deskriptive Statistik",
        "Präsentation von empirischen Daten"
      ],
